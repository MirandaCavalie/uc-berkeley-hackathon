# Optional. Without a key the app runs on its deterministic local engine.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# openai | anthropic — only needed when both keys are set
AI_PROVIDER=
# Override the default model for the chosen provider
AI_MODEL=

# Optional. Jev (TypeSafe) decides step modes, judgment scores, comment labels, and event stages.
JEV_API_KEY=
JEV_MODEL=
