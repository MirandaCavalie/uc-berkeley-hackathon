# Optional. Jev (TypeSafe) routes interview turns and decides task processes,
# solution types, and readiness scores.
# Without a key, Fieldwork uses its rule-based process catalog.
JEV_API_KEY=
JEV_MODEL=

# Optional. My work → "Prepare my meeting" skill.
# Without a key, the helper returns a clearly labelled template worksheet.
OPENAI_API_KEY=
OPENAI_MEETING_MODEL=

# Optional. Google Calendar connection for My work (read-only events).
# Setup steps: docs/PERSONAL-WORKSPACE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Live employee research. Node 22.13+ with a persistent local disk is required.
OPENAI_INTERVIEW_MODEL=gpt-5.4-mini
# In production set this to a unique password of at least 12 characters.
# Local development also supports creating the owner at /research.
FIELDWORK_ADMIN_PASSWORD=
FIELDWORK_DB_PATH=data/discovery.sqlite
# Employees must be able to reach this HTTPS address; localhost cannot be emailed.
FIELDWORK_PUBLIC_URL=
# Gmail: enable 2-step verification and use an app password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
