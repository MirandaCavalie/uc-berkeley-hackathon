# Optional. Jev (TypeSafe) routes interview turns and decides task processes,
# solution types, and readiness scores.
# Without a key, Fieldwork uses its rule-based process catalog.
JEV_API_KEY=
JEV_MODEL=

# Optional. My work → "Prepare my meeting" skill.
# Without a key, the helper returns a clearly labelled template worksheet.
OPENAI_API_KEY=
OPENAI_MEETING_MODEL=

# Optional. Google Calendar connection for My work (read-only events).
# Setup steps: docs/PERSONAL-WORKSPACE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
